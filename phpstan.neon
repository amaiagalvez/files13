includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phpstan-baseline.neon

parameters:
    scanFiles:
        - vendor/amaia/basics13/tests/TestCase.php
        - vendor/amaia/basics13/tests/TranslationFilesTestCase.php
        - vendor/amaia/basics13/tests/BootstrapTestCase.php
        - vendor/amaia/basics13/tests/PackageIsolationTestCase.php
        - vendor/amaia/basics13/tests/ChecksResourceArchitecture.php
        
    paths:
        - config/
        - database/
        - resources/
        - src/
        - tests/

    level: 7

    # config/files13.php is merged into the host config, so its env() calls are cached like any
    # config file; Larastan only recognises the host's own config/ directory.
    noEnvCallsOutsideOfConfig: false
